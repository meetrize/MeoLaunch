# meoLaunch website — local overrides

# Primary download link (DMG / ZIP / Release asset). Falls back to GitHub Releases.
PUBLIC_DOWNLOAD_URL=https://github.com/meetrize/MeoLaunch/releases/latest

# Set to "true" when Developer ID + notarization are ready (switches trust microcopy).
PUBLIC_NOTARIZED=false

# Optional: Buttondown / Loops form action URL. Leave empty to show mailto / community only.
PUBLIC_SUBSCRIBE_ACTION=

# Optional site origin for OG absolute URLs
PUBLIC_SITE_URL=http://www.meofind.top/meolaunch
