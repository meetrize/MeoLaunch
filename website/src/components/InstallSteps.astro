---
import { install } from '../content/copy';
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="wrap">
    <h2 id="install-title" class="section-title">{install.title}</h2>
    <p class="section-lead">{install.subtitle}</p>
    <ol class="steps">
      {
        install.steps.map((s) => (
          <li>
            <span class="step-n" aria-hidden="true">
              {s.n}
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .install {
    border-top: 1px solid var(--line);
  }

  .steps {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  li {
    padding: 1.25rem 1.2rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
  }

  .step-n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.85rem;
    letter-spacing: 0.04em;
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  p {
    color: var(--muted);
    margin: 0;
    font-size: 0.98rem;
  }
</style>
