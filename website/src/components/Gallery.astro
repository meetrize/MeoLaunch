---
import { withBase } from '../lib/paths';
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <h2 id="gallery-title" class="section-title">一眼看懂产品气质</h2>
    <p class="section-lead">图标、网格、热角与底栏——同一份极致轻量里的完整体感。</p>
    <div class="mosaic">
      <figure class="media-frame tall">
        <img src={withBase('/media/app-icon.png')} alt="meoLaunch 应用图标" width="640" height="640" loading="lazy" />
        <figcaption>应用图标</figcaption>
      </figure>
      <figure class="media-frame wide">
        <img src={withBase('/media/hero-product.jpg')} alt="应用网格大图" width="1280" height="800" loading="lazy" />
        <figcaption>全屏网格</figcaption>
      </figure>
      <figure class="media-frame">
        <img src={withBase('/media/app-icon-mark.png')} alt="品牌标记图标" width="640" height="640" loading="lazy" />
        <figcaption>品牌标记</figcaption>
      </figure>
      <figure class="media-frame">
        <img src={withBase('/media/menubar-chip.png')} alt="菜单栏图标预览" width="320" height="80" loading="lazy" />
        <figcaption>菜单栏入口</figcaption>
      </figure>
      <figure class="media-frame wide">
        <img src={withBase('/media/taskbar-photo.jpg')} alt="Taskbar 场景" width="1280" height="720" loading="lazy" />
        <figcaption>Taskbar 场景</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .gallery {
    border-top: 1px solid var(--line);
  }

  .mosaic {
    margin-top: 2.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 780px) {
    .mosaic {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: minmax(9rem, auto);
    }

    .tall {
      grid-column: span 2;
      grid-row: span 2;
    }

    .wide {
      grid-column: span 4;
    }

    .mosaic > :not(.tall):not(.wide) {
      grid-column: span 2;
    }
  }

  figure {
    margin: 0;
  }

  img {
    width: 100%;
    height: 100%;
    min-height: 10rem;
    object-fit: cover;
    background: var(--bg-soft);
  }

  .tall img {
    object-fit: contain;
    padding: 1.5rem;
    background: linear-gradient(160deg, #fff, #e8eef6);
  }

  figcaption {
    padding: 0.7rem 0.9rem 0.85rem;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
